  * \retval -1 error
  */
 
+/* CELLINFO: LTE signal quality of the serving cell. Other access technologies leave it unknown.
+ * Quectel: +QENG: "servingcell",<state>,"LTE",<duplex>,<mcc>,<mnc>,<cellid>,<pci>,<earfcn>,<band>,<ul_bw>,<dl_bw>,<tac>,<rsrp>,<rsrq>,<rssi>,<sinr>,...
+ * SIMCom:  +CPSI: LTE,<state>,<mcc-mnc>,<tac>,<cellid>,<pci>,<band>,<earfcn>,<dl_bw>,<ul_bw>,<rsrq*10>,<rsrp*10>,<rssi*10>,<rssnr>
+ */
+static int at_response_cellinfo (struct pvt* pvt, const char* str)
+{
+	char buf[256];
+	char* f[24];
+	int n = 0;
+	char* p;
+
+	ast_copy_string (buf, str, sizeof (buf));
+	p = strchr (buf, ':');
+	if (!p)
+		return 0;
+	for (p++; n < (int) ITEMS_OF(f); )
+	{
+		while (*p == ' ' || *p == '"') p++;
+		f[n++] = p;
+		p = strchr (p, ',');
+		if (!p)
+			break;
+		*p++ = '\0';
+	}
+	for (int i = 0; i < n; i++)
+	{
+		char* q = strchr (f[i], '"');
+		if (q) *q = '\0';
+	}
+
+	pvt->rsrp = pvt->rsrq = pvt->sinr = SIGNAL_UNKNOWN;
+	if (!strncmp (str, "+QENG:", 6) && n >= 17 && !strcmp (f[2], "LTE"))
+	{
+		pvt->rsrp = atoi (f[13]);
+		pvt->rsrq = atoi (f[14]);
+		pvt->sinr = atoi (f[16]);
+	}
+	else if (!strncmp (str, "+CPSI:", 6) && n >= 14 && !strcmp (f[0], "LTE"))
+	{
+		pvt->rsrq = atoi (f[10]) / 10;
+		pvt->rsrp = atoi (f[11]) / 10;
+		pvt->sinr = atoi (f[13]);
+	}
+	return 0;
+}
