+/*!
+ * \brief Enqueue the serving cell query (CELLINFO): AT+CPSI? on SIMCom, AT+QENG="servingcell" on Quectel
+ * \param cpvt -- cpvt structure
+ * \return 0 on success
+ */
+EXPORT_DEF int at_enqueue_cellinfo(struct cpvt *cpvt)
+{
+	static const char cmd_cpsi[] = "AT+CPSI?\r";
+	static const char cmd_qeng[] = "AT+QENG=\"servingcell\"\r";
+	static const at_queue_cmd_t simcom[] = { ATQ_CMD_DECLARE_ST(CMD_AT_CELLINFO, cmd_cpsi) };
+	static const at_queue_cmd_t quectel[] = { ATQ_CMD_DECLARE_ST(CMD_AT_CELLINFO, cmd_qeng) };
+	struct pvt *pvt = cpvt->pvt;
+
+	if (pvt->no_cellinfo || !pvt->connected || !pvt->initialized)
+		return 0;
+	if (at_queue_insert_const(cpvt, pvt->is_simcom ? simcom : quectel, 1, 0) != 0) {
+		chan_quectel_err = E_QUEUE;
+		return -1;
+	}
+	return 0;
+}
