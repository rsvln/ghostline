diff --git a/at_response.c b/at_response.c
index 95570bb..ec1c832 100644
--- a/at_response.c
+++ b/at_response.c
@@ -1853,6 +1853,11 @@ static int at_response_cnum (struct pvt* pvt, char* str)
 
 static int at_response_cops (struct pvt* pvt, char* str)
 {
+	/* the 4th field is the access technology: +COPS: 0,0,"NAME",7 (0 GSM, 2 UTRAN, 7 E-UTRAN) */
+	const char* last = strrchr (str, ',');
+	int commas = 0;
+	for (const char* c = str; *c; c++) if (*c == ',') commas++;
+	pvt->act = (commas >= 3 && last) ? atoi (last + 1) : -1;
 	char* provider_name = at_parse_cops (str);
 
 	if (provider_name)
@@ -1905,6 +1910,7 @@ static int at_response_creg (struct pvt* pvt, char* str, size_t len)
 	else
 	{
 		pvt->gsm_registered = 0;
+		pvt->act = -1;
 		manager_event_device_status(PVT_ID(pvt), "Unregister");
 	}
 
