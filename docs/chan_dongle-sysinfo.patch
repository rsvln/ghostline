+/* Network mode query; the answer sets linkmode/linksubmode like ^MODE does */
+EXPORT_DEF int at_enqueue_sysinfo(struct cpvt *cpvt)
+{
+	static const char cmd[] = "AT^SYSINFO\r";
+	static at_queue_cmd_t at_cmd = ATQ_CMD_DECLARE_ST(CMD_AT_SYSINFO, cmd);
+
+	if (at_queue_insert_const(cpvt, &at_cmd, 1, 0) != 0) {
+		chan_dongle_err = E_QUEUE;
+		return -1;
+	}
+	return 0;
+}
