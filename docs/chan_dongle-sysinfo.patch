+/*!
+ * \brief Handle the ^SYSINFO answer
+ * ^SYSINFO:<srv_status>,<srv_domain>,<roam>,<sys_mode>,<sim_state>[,<lock>,<sys_submode>]
+ * The mode and submode use the same codes as ^MODE.
+ */
+static int at_response_sysinfo (struct pvt* pvt, const char* str)
+{
+	const char* p = strstr (str, "^SYSINFO:");
+	int field = 0, mode = -1, submode = -1;
+
+	if (!p)
+		return 0;
+	for (p += 9; *p; p++)
+	{
+		if (*p == ',')
+		{
+			field++;
+			continue;
+		}
+		if (field == 3 && mode < 0)
+			mode = atoi (p);
+		else if (field == 6 && submode < 0)
+			submode = atoi (p);
+	}
+	if (mode >= 0)
+	{
+		pvt->linkmode = mode;
+		/* No submode field (older firmware): keep the one ^MODE gave, unless there is no service */
+		if (submode >= 0 || mode == 0)
+			pvt->linksubmode = submode >= 0 ? submode : 0;
+	}
+	return 0;
+}
